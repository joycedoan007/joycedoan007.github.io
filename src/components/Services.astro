---
const services = [
  {
    icon: 'ph-chart-bar',
    title: 'Dashboard & Data UX',
    body: 'Making complex data easier to navigate, understand, and act on through structured layouts and thoughtful information hierarchy.',
  },
  {
    icon: 'ph-browsers',
    title: 'Product UX & UI',
    body: 'End-to-end product design, from understanding user needs to defining workflows, interactions, and polished interfaces.',
  },
  {
    icon: 'ph-sparkle',
    title: 'AI-integrated Interfaces',
    body: 'Designing for AI-powered experiences, including intelligent workflows, automation, human control, and graceful failure states.',
  },
  {
    icon: 'ph-stack',
    title: 'Design Systems',
    body: 'Building scalable components, design tokens, and documentation that help teams maintain consistency and move faster.',
  },
];

---

<section id="services" style="border-bottom: 1px solid var(--border-subtle);">
  <div style="max-width: 1320px; margin: 0 auto; padding: 96px 48px;">
    <div data-reveal style="margin-bottom: 56px;">
      <div class="overline" data-i18n style="margin-bottom: 12px;">Expertise</div>
      <h2
        style="font: 500 clamp(30px, 3.4vw, 44px)/1.1 'Poppins', sans-serif; letter-spacing: -0.03em; color: var(--text-bright); margin: 0 0 48px;"
      >
        <span data-i18n>Dense data, calm screens.</span>
      </h2>
      <p data-i18n style="font: 400 16px/26px 'Poppins', sans-serif; color: var(--text-primary); margin: 0; max-width: 620px; text-wrap: pretty;">
        I design digital products that make complex information easier to understand and everyday workflows easier to manage.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
      {
        services.map((s, i) => (
          <div
            data-reveal
            class="service-card"
            data-cursor="hover"
            style={`--reveal-delay: ${i * 50}ms;`}
          >
            <span class="service-card__icon"><i class={`ph-bold ${s.icon}`}></i></span>
            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: auto;">
              <h3
                data-i18n
                style="font: 500 28px/34px 'Poppins', sans-serif; letter-spacing: -0.02em; color: var(--text-bright); margin: 0;"
              >
                {s.title}
              </h3>
              <p
                data-i18n
                style="font: 400 15px/24px 'Poppins', sans-serif; color: var(--text-primary); margin: 0; max-width: 460px;"
              >
                {s.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 56px;
    min-height: 300px;
    padding: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--primary-500) 22%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 350ms ease;
  }
  .service-card:hover::before { opacity: 1; }
  .service-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    font-size: 22px;
    color: var(--text-bright);
    transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease, transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .service-card:hover .service-card__icon {
    background: var(--primary-700);
    border-color: var(--primary-700);
    color: var(--text-inverse);
    transform: rotate(-8deg) scale(1.08);
  }
  @media (max-width: 900px) {
    #services [style*='repeat(2, 1fr)'] { grid-template-columns: 1fr !important; }
    .service-card { min-height: 0; padding: 24px; gap: 40px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
