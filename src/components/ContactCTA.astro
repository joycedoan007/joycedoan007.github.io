---
<section style="border-top: 1px solid var(--border-subtle);">
  <div style="max-width: 1320px; margin: 0 auto; padding: 96px 48px; display: flex; justify-content: space-between; align-items: center; gap: 48px;">
    <div>
      <div class="overline" style="margin-bottom: 16px;" data-i18n>Get in touch</div>
      <h2 style="font: 500 clamp(30px, 3.4vw, 44px)/1.1 'Poppins', sans-serif; letter-spacing: -0.025em; color: var(--text-bright); margin: 0; max-width: 600px;" data-i18n>
        Looking for a designer to join your team? Let's talk.
      </h2>
    </div>
    <a
      href="/contact"
      style="flex-shrink: 0;"
      class="btn btn--primary cta-link"
    >
      <span data-i18n>Tell me about your team</span>
    </a>
  </div>
</section>

