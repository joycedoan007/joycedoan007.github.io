---
interface WritingItem {
  title: string;
  date: string;
  readTime: string;
  description: string;
  notionUrl: string;
  slug: string;
  titleVi?: string;
  descriptionVi?: string;
  readTimeVi?: string;
  categoryVi?: string;
}
interface Props {
  items: WritingItem[];
}
const { items } = Astro.props;
---

<section id="writing" style="border-bottom: 1px solid var(--border-subtle);">
  <div style="max-width: 1320px; margin: 0 auto; padding: 96px 48px;">
    <div
      data-reveal
      style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--border-subtle);"
    >
      <div>
        <div class="overline" data-i18n style="margin-bottom: 12px;">Writing</div>
        <h2
          style="font: 500 clamp(30px, 3.4vw, 44px)/1.1 'Poppins', sans-serif; letter-spacing: -0.03em; color: var(--text-bright); margin: 0;"
        >
          <span data-i18n>Things I figured out.</span>
        </h2>
      </div>
      <p
        data-i18n
        style="font: 400 15px/24px 'Poppins', sans-serif; color: var(--text-primary); max-width: 360px; margin: 0;"
      >
        Short, practical write-ups drawn from my own projects and experiments.
      </p>
    </div>

    {
      items.map((w, i) => (
        <a
          href={`/writing/${w.slug}`}
          data-cursor="hover"
          data-reveal
          style={`--reveal-delay: ${i * 40}ms; display: grid; grid-template-columns: 64px 200px 1fr 200px 32px; gap: 32px; align-items: center; padding: 28px 0;${i < items.length - 1 ? ' border-bottom: 1px solid var(--border-subtle);' : ''} text-decoration: none; color: inherit; transition: background 200ms ease, padding 200ms ease;`}
          class="writing-row"
        >
          <span
            style="font: 500 14px/18px 'JetBrains Mono', monospace; color: var(--text-secondary);"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <span
            style="font: 500 13px/20px 'JetBrains Mono', monospace; color: var(--text-secondary);"
          >
            <span data-lang-block="en">{new Date(w.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })} · {w.readTime}</span><span data-lang-block="vi">{new Date(w.date).toLocaleDateString('vi-VN', { month: 'short', year: 'numeric' })} · {w.readTimeVi ?? w.readTime}</span>
          </span>
          <h3
            style="font: 500 24px/30px 'Poppins', sans-serif; letter-spacing: -0.015em; color: var(--text-bright); margin: 0;"
          >
            <span data-lang-block="en">{w.title}</span><span data-lang-block="vi">{w.titleVi ?? w.title}</span>
          </h3>
          <p
            style="font: 400 14px/20px 'Poppins', sans-serif; color: var(--text-primary); margin: 0;"
          >
            <span data-lang-block="en">{w.description}</span><span data-lang-block="vi">{w.descriptionVi ?? w.description}</span>
          </p>
          <i
            class="ph-bold ph-arrow-up-right"
            style="font-size: 16px; color: var(--text-secondary);"
          />
        </a>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll('.writing-row').forEach((el) => {
    el.addEventListener('mouseenter', () => {
      (el as HTMLElement).style.background = 'var(--bg-surface)';
      (el as HTMLElement).style.paddingLeft = '16px';
      (el as HTMLElement).style.paddingRight = '16px';
    });
    el.addEventListener('mouseleave', () => {
      (el as HTMLElement).style.background = 'transparent';
      (el as HTMLElement).style.paddingLeft = '0';
      (el as HTMLElement).style.paddingRight = '0';
    });
  });
</script>
