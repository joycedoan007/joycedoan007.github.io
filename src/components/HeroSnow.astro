---
---

<canvas class="hero-snow" aria-hidden="true"></canvas>

<script>
  // Snowfall ported from Snowpuff's flake model: depth sets size/speed/alpha/wind, flakes sway on their own
  // phase, a slow layered-sine breeze pushes them, and a moving cursor drags nearby flakes along.
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-snow');
  const hero = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');
  if (canvas && hero && ctx && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    type Flake = { x: number; y: number; vx: number; vy: number; fall: number; size: number; depth: number; alpha: number; near: boolean; soft: number; phase: number; rate: number; sway: number };
    const PHASE_WRAP = 20 * Math.PI;
    const PER_MEGAPIXEL = 320;
    const WAKE_RADIUS = 90;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    let w = 0, h = 0, raf = 0, last = 0, clock = 0, visible = true;
    let flakes: Flake[] = [];
    let cursor: { x: number; y: number } | null = null;
    let cursorV = { x: 0, y: 0 };
    let sprites: HTMLCanvasElement[] = [];

    // Ground: a height field of COL-wide columns along the bottom edge. Landing flakes add area through a
    // smoothing kernel, steep slopes slump to a repose angle, the pile thaws in proportion to its depth, and
    // the cursor ploughs it aside, throwing loose grains that fall back and settle again.
    const COL = 3;
    const DEPOSIT = 6;       // visible scale-up of a flake's area so a pile builds in tens of seconds
    const THAW = 0.025;      // share of a column's height lost per second
    const REPOSE = 0.9;      // max height difference per column step, in px
    const KERNEL = [[-2, 0.0625], [-1, 0.25], [0, 0.375], [1, 0.25], [2, 0.0625]];
    const MAX_GRAINS = 600;
    let ground = new Float32Array(0);
    type Grain = { x: number; y: number; vx: number; vy: number; size: number };
    const grains: Grain[] = [];
    let lightTheme = false;

    function makeSprite(soft: number, core: string, rim: string) {
      const s = document.createElement('canvas');
      s.width = s.height = 64;
      const c = s.getContext('2d')!;
      const g = c.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, core);
      g.addColorStop(Math.max(0.05, 0.6 - soft * 0.6), core);
      g.addColorStop(1, rim);
      c.fillStyle = g;
      c.fillRect(0, 0, 64, 64);
      return s;
    }
    function buildSprites() {
      const light = document.documentElement.dataset.theme === 'light';
      // Cream background in light mode: white would vanish, so flakes turn a cool slate there.
      const core = light ? 'rgba(122,138,160,1)' : 'rgba(255,250,240,1)';
      const rim = light ? 'rgba(122,138,160,0)' : 'rgba(255,250,240,0)';
      lightTheme = light;
      sprites = [0, 1, 2, 3].map((i) => makeSprite(i / 3, core, rim));
    }

    function make(y: number): Flake {
      const near = Math.random() < 0.02;
      const depth = near ? 1 : Math.pow(Math.random(), 1.6);
      const fall = near ? rand(75, 100) : 16 + depth * 50 + rand(0, 10);
      return {
        x: rand(-30, w + 30), y,
        vx: breeze() * (0.35 + 0.65 * depth), vy: fall,
        fall,
        size: near ? rand(8, 13) : 1.4 + depth * 4.4 + rand(0, 1),
        depth, near,
        alpha: near ? 0.28 : 0.4 + depth * 0.5,
        soft: near ? 0.95 : 0.75 - depth * 0.45,
        phase: rand(0, PHASE_WRAP),
        rate: rand(0.5, 1.4),
        sway: near ? rand(10, 20) : rand(4, 9) + depth * 10,
      };
    }
    function breeze() {
      return 10 * Math.sin(clock * 0.07) + 6 * Math.sin(clock * 0.19 + 1.7) + 3 * Math.sin(clock * 0.43 + 4.1);
    }
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = hero!.clientWidth; h = hero!.clientHeight;
      canvas!.width = Math.round(w * dpr); canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.round(PER_MEGAPIXEL * (w * h) / 1e6 * (w < 700 ? 0.6 : 1));
      const cols = Math.ceil(w / COL) + 1;
      if (ground.length !== cols) {
        const next = new Float32Array(cols);
        next.set(ground.subarray(0, Math.min(cols, ground.length)));
        ground = next;
      }
      if (flakes.length > target) flakes.length = target;
      while (flakes.length < target) flakes.push(make(rand(0, h)));
    }

    function deposit(x: number, area: number) {
      const c = Math.floor(x / COL);
      const amount = area / COL;
      for (const [o, k] of KERNEL) {
        const i = c + o;
        if (i >= 0 && i < ground.length) ground[i] += amount * k;
      }
    }
    function groundAt(x: number) {
      const i = Math.min(ground.length - 1, Math.max(0, Math.floor(x / COL)));
      return ground[i];
    }
    function relax(dt: number) {
      const thaw = Math.exp(-THAW * dt);
      for (let i = 0; i < ground.length; i++) ground[i] *= thaw;
      // Light diffusion rounds lumpy landings into drifts.
      const k = Math.min(0.5, dt * 6);
      let left = ground[0];
      for (let i = 1; i < ground.length - 1; i++) {
        const here = ground[i];
        ground[i] += ((left + ground[i + 1]) / 2 - here) * k;
        left = here;
      }
      for (let pass = 0; pass < 2; pass++) {
        for (let i = 0; i < ground.length - 1; i++) {
          const d = ground[i] - ground[i + 1];
          if (Math.abs(d) > REPOSE) {
            const move = (Math.abs(d) - REPOSE) * 0.5 * Math.sign(d);
            ground[i] -= move; ground[i + 1] += move;
          }
        }
        for (let i = ground.length - 1; i > 0; i--) {
          const d = ground[i] - ground[i - 1];
          if (Math.abs(d) > REPOSE) {
            const move = (Math.abs(d) - REPOSE) * 0.5 * Math.sign(d);
            ground[i] -= move; ground[i - 1] += move;
          }
        }
      }
    }
    // The cursor scoops snow out of the columns it passes through and flings it as grains.
    function carve(dt: number, vx: number, vy: number) {
      if (!cursor) return;
      const R = 46;
      if (cursor.y < h - R - 30) return;
      const speed = Math.hypot(vx, vy);
      if (speed < 40) return;
      const c0 = Math.floor((cursor.x - R) / COL), c1 = Math.ceil((cursor.x + R) / COL);
      for (let i = Math.max(0, c0); i <= Math.min(ground.length - 1, c1); i++) {
        const dx = i * COL - cursor.x;
        const reach = Math.sqrt(Math.max(0, R * R - dx * dx));
        const bottom = cursor.y + reach, top = cursor.y - reach;
        const surface = h - ground[i];
        if (ground[i] < 0.3 || surface > bottom || surface + ground[i] < top) continue;
        const cut = Math.min(ground[i], Math.max(0, bottom - surface)) * Math.min(1, dt * 6 * (speed / 400 + 0.3));
        if (cut <= 0) continue;
        ground[i] -= cut;
        let n = Math.min(3, Math.round(cut * COL / 5));
        if (Math.random() < (cut * COL / 5) % 1) n++;
        for (; n > 0 && grains.length < MAX_GRAINS; n--) {
          grains.push({
            x: i * COL + rand(0, COL), y: surface,
            vx: Math.max(-700, Math.min(700, vx * 0.5)) + rand(-90, 90),
            vy: Math.max(-700, Math.min(700, vy * 0.5)) - rand(40, 220),
            size: rand(1.4, 2.6),
          });
        }
      }
    }
    function stepGrains(dt: number) {
      for (let i = grains.length - 1; i >= 0; i--) {
        const g = grains[i];
        g.vy += 900 * dt;
        g.vx *= Math.exp(-0.8 * dt);
        g.x += g.vx * dt; g.y += g.vy * dt;
        if (g.x < 0 || g.x > w || g.y > h) {
          if (g.x >= 0 && g.x <= w) deposit(g.x, g.size * g.size * 2);
          grains.splice(i, 1);
          continue;
        }
        if (g.vy > 0 && g.y >= h - groundAt(g.x)) {
          deposit(g.x, g.size * g.size * 2);
          grains.splice(i, 1);
          continue;
        }
        ctx!.globalAlpha = 0.85;
        const s = g.size * 2;
        ctx!.drawImage(sprites[1], g.x - s / 2, g.y - s / 2, s, s);
      }
    }
    function drawGround() {
      let peak = 0;
      for (let i = 0; i < ground.length; i++) if (ground[i] > peak) peak = ground[i];
      if (peak < 0.25) return;
      ctx!.globalAlpha = 1;
      ctx!.beginPath();
      ctx!.moveTo(0, h);
      for (let i = 0; i < ground.length; i++) ctx!.lineTo(i * COL, h - ground[i]);
      ctx!.lineTo(w, h);
      ctx!.closePath();
      const g = ctx!.createLinearGradient(0, h - peak, 0, h);
      if (lightTheme) {
        g.addColorStop(0, 'rgba(255,255,255,0.98)');
        g.addColorStop(1, 'rgba(236,240,246,0.9)');
      } else {
        g.addColorStop(0, 'rgba(244,246,250,0.95)');
        g.addColorStop(1, 'rgba(244,246,250,0.35)');
      }
      ctx!.fillStyle = g;
      ctx!.fill();
      if (lightTheme) {
        ctx!.strokeStyle = 'rgba(122,138,160,0.45)';
        ctx!.lineWidth = 1;
        ctx!.stroke();
      }
    }

    function frame(now: number) {
      raf = visible && !document.hidden ? requestAnimationFrame(frame) : 0;
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      if (dt <= 0) return;
      clock += dt;

      const wind = breeze();
      const follow = Math.min(1, dt * 1.2), settle = Math.min(1, dt * 1.6);
      const speed = Math.hypot(cursorV.x, cursorV.y);
      const wake = cursor && speed > 20 ? { ...cursor, k: speed > 500 ? 500 / speed : 1 } : null;
      cursorV.x *= Math.pow(0.001, dt); cursorV.y *= Math.pow(0.001, dt);

      ctx!.clearRect(0, 0, w, h);
      relax(dt);
      carve(dt, cursorV.x, cursorV.y);
      for (let i = 0; i < flakes.length; i++) {
        const f = flakes[i];
        f.vx += (wind * (0.35 + 0.65 * f.depth) - f.vx) * follow;
        f.vy += (f.fall - f.vy) * settle;
        if (wake) {
          const dx = f.x - wake.x, dy = f.y - wake.y, d2 = dx * dx + dy * dy;
          if (d2 < WAKE_RADIUS * WAKE_RADIUS) {
            const fo = 1 - Math.sqrt(d2) / WAKE_RADIUS;
            const m = Math.min(1, fo * fo * 4 * dt);
            f.vx += (cursorV.x * wake.k - f.vx) * m;
            f.vy += (cursorV.y * wake.k - f.vy) * m; // y is down on screen, same as cursor
          }
        }
        f.phase += f.rate * dt;
        if (f.phase > PHASE_WRAP) f.phase -= PHASE_WRAP;
        const sway = (Math.cos(f.phase) + 0.3 * Math.cos(f.phase * 2.3)) * f.sway;
        f.x += (f.vx + sway) * dt;
        f.y += f.vy * (1 + 0.12 * Math.sin(f.phase * 1.3)) * dt;

        if (f.x < -30) f.x += w + 60; else if (f.x > w + 30) f.x -= w + 60;
        if (!f.near && f.y >= h - groundAt(f.x)) {
          deposit(f.x, f.size * f.size * DEPOSIT * (0.4 + f.depth));
          flakes[i] = make(-f.size * 2 - rand(0, 40));
          continue;
        }
        if (f.y > h + f.size * 2) { flakes[i] = make(-f.size * 2 - rand(0, 40)); flakes[i].x = rand(-30, w + 30); continue; }
        if (f.y < -h) { f.y = -f.size; f.vy = f.fall; }

        const s = f.size * 2;
        ctx!.globalAlpha = f.alpha;
        ctx!.drawImage(sprites[Math.round(f.soft * 3)], f.x - s / 2, f.y - s / 2, s, s);
      }
      stepGrains(dt);
      drawGround();
    }
    const start = () => { if (!raf && visible && !document.hidden) { last = performance.now(); raf = requestAnimationFrame(frame); } };

    buildSprites();
    resize();
    new ResizeObserver(resize).observe(hero);
    new MutationObserver(buildSprites).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }).observe(hero);
    document.addEventListener('visibilitychange', start);

    if (matchMedia('(hover: hover)').matches) {
      let prev: { x: number; y: number; t: number } | null = null;
      document.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        if (prev) {
          const dt = Math.max((e.timeStamp - prev.t) / 1000, 1 / 240);
          cursorV.x += ((x - prev.x) / dt - cursorV.x) * 0.5;
          cursorV.y += ((y - prev.y) / dt - cursorV.y) * 0.5;
        }
        prev = { x, y, t: e.timeStamp };
        cursor = { x, y };
      });
      document.documentElement.addEventListener('pointerleave', () => { cursor = null; prev = null; });
    }
    start();
  }
</script>

<style>
  .hero-snow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
</style>
