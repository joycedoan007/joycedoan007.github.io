---
import ThemeToggle from './ThemeToggle';
import LangSwitch from './LangSwitch.astro';

const home = Astro.url.pathname === '/';
---

<header
  id="site-header"
  style="position: sticky; top: 0; z-index: 50; padding: 12px 38px; pointer-events: none;"
>
  <div
    class="site-header__bar"
    style="max-width: 1244px; margin: 0 auto; padding: 10px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px; pointer-events: auto; border: 1px solid var(--border-subtle); border-radius: 16px; background: color-mix(in srgb, var(--bg-page) 78%, transparent); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4); box-shadow: 0 8px 32px -12px rgba(0, 0, 0, 0.18);"
  >
    <!-- Logo -->
    <a
      href={home ? '#top' : '/'}
      style="text-decoration: none; display: inline-flex; align-items: center;"
    >
      <img
        src="/logo.svg"
        alt="Joyce Doan"
        height="20"
        style="display: block; filter: var(--logo-filter);"
      />
    </a>

    <!-- Nav -->
    <nav class="nav-fx" style="display: flex; gap: 0; align-items: center;">
      {
        [
          ['Work', '/work'],
          ['About', '/about'],
          ['Writing', '/writing'],
          ['Contact', '/contact'],
        ].map(([label, href]) => (
          <a
            href={href}
            data-cursor="hover"
            style="padding: 6px 14px; font: 500 14px/20px 'Poppins', sans-serif; color: var(--text-primary); text-decoration: none;"
          >
            <span data-i18n>{label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Right: availability + theme toggle -->
    <div
      style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-left: auto;"
    >
      <!-- Availability badge (hidden for now, re-enable by removing display:none) -->
      <span
        style="display: none; align-items: center; gap: 8px; font: 500 12px/16px 'JetBrains Mono', monospace; color: var(--text-secondary);"
      >
        <span
          style="width: 6px; height: 6px; border-radius: 50%; background: var(--primary-500); box-shadow: 0 0 8px color-mix(in srgb, var(--primary-500) 60%, transparent);"
        ></span>
        Available · Q3
      </span>

      <LangSwitch />

      <ThemeToggle client:load />

      <a
        href={home ? '#book' : '/contact'}
        data-cursor="hover"
        class="btn btn--primary site-header__cta"
        style="height: 38px; padding: 0 18px;"
      >
        <span data-i18n>Book a call</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;
    function setHeaderHeight() {
      document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
    }
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight);
  })();
</script>

