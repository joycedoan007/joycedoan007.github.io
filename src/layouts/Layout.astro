---
import '../styles/global.css';
import I18nRuntime from '../components/I18nRuntime.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Joyce Doan - UI/UX Designer',
  description = 'UI/UX designer focused on data-driven products. Dashboards, complex interfaces, AI. Currently at Consortia Group.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@100..900&display=swap"
    rel="stylesheet"
  />

  <!-- Phosphor Icons -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css"
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
  />

  <style>
    /* Prevent FOUC for dark/light theme */
  </style>
</head>
<body>
  <slot />

  <I18nRuntime />

  <!-- Theme persistence: runs before React hydrates -->
  <script is:inline>
    (function () {
      var saved = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
      document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
    })();
  </script>

  <!-- Scroll-reveal watcher -->
  <script>
    function initReveal() {
      const els = document.querySelectorAll('[data-reveal]');
      if (!els.length) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      els.forEach((el) => io.observe(el));
    }
    // Run after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReveal);
    } else {
      initReveal();
    }
  </script>

  <!-- AI-mode switch: green glow that follows the cursor (position set relative to the label and the track) -->
  <script>
    document.addEventListener('pointermove', (e) => {
      const sw = (e.target as HTMLElement | null)?.closest<HTMLElement>('.ai-switch');
      if (!sw) return;
      for (const el of Array.from(sw.children) as HTMLElement[]) {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      }
    });
  </script>
  <script is:inline>
    document.querySelectorAll('.prose img').forEach(function (img) {
      if (img.parentElement.classList.contains('grain-img')) return;
      var wrap = document.createElement('span');
      wrap.className = 'grain-img';
      img.parentNode.insertBefore(wrap, img);
      wrap.appendChild(img);
    });
  </script>
  <script is:inline>
    // Buttons: split label into a rolling pair, clone the arrow for a diagonal swap, and pull toward the cursor
    (function () {
      function enhance(btn) {
        if (btn.dataset.fx) return;
        btn.dataset.fx = '1';
        var kids = Array.prototype.slice.call(btn.childNodes);
        var labelNodes = kids.filter(function (n) { return !(n.nodeType === 1 && n.tagName === 'I'); });
        if (labelNodes.some(function (n) { return n.textContent.trim(); })) {
          var roll = document.createElement('span');
          roll.className = 'btn__roll';
          var inner = document.createElement('span');
          inner.className = 'btn__roll-in';
          roll.appendChild(inner);
          btn.insertBefore(roll, labelNodes[0]);
          labelNodes.forEach(function (n) { inner.appendChild(n); });
        }
        Array.prototype.slice.call(btn.children).forEach(function (i) {
          if (i.tagName !== 'I') return;
          var wrap = document.createElement('span');
          wrap.className = 'btn__icon' + (i.classList.contains('ph-arrow-left') ? ' btn__icon--left' : i.classList.contains('ph-arrow-right') ? ' btn__icon--right' : '');
          btn.insertBefore(wrap, i);
          wrap.appendChild(i);
          wrap.appendChild(i.cloneNode(true));
        });
      }
      function run() { document.querySelectorAll('.btn').forEach(enhance); }
      run();
      new MutationObserver(run).observe(document.body, { childList: true, subtree: true });

      if (!window.matchMedia('(hover: hover)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.addEventListener('pointermove', function (e) {
        var btn = e.target.closest && e.target.closest('.btn');
        if (!btn) return;
        var r = btn.getBoundingClientRect();
        btn.style.transitionDuration = '120ms';
        btn.style.setProperty('--tx', (e.clientX - r.left - r.width / 2) * 0.22 + 'px');
        btn.style.setProperty('--ty', (e.clientY - r.top - r.height / 2) * 0.32 + 'px');
      });
      document.addEventListener('pointerout', function (e) {
        var btn = e.target.closest && e.target.closest('.btn');
        if (!btn || btn.contains(e.relatedTarget)) return;
        btn.style.transitionDuration = '';
        btn.style.setProperty('--tx', '0px');
        btn.style.setProperty('--ty', '0px');
      });
    })();
  </script>
  <script is:inline>
    // Nav hover: a highlight pill slides to the hovered link and fades out when the pointer leaves (any <nav class="nav-fx">)
    (function () {
      if (!window.matchMedia('(hover: hover)').matches) return;
      document.querySelectorAll('nav.nav-fx').forEach(function (nav) {
        var pill = document.createElement('span');
        pill.className = 'nav-pill';
        pill.setAttribute('aria-hidden', 'true');
        nav.insertBefore(pill, nav.firstChild);
        var shown = false;
        function moveTo(link) {
          var set = function () {
            pill.style.setProperty('--x', link.offsetLeft + 'px');
            pill.style.setProperty('--w', link.offsetWidth + 'px');
            pill.style.setProperty('--h', link.offsetHeight + 'px');
          };
          if (!shown) {
            pill.style.transition = 'none';
            set();
            void pill.offsetWidth;
            pill.style.transition = '';
            shown = true;
          } else {
            set();
          }
          pill.style.opacity = '1';
        }
        nav.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('mouseenter', function () { moveTo(a); });
          a.addEventListener('focus', function () { moveTo(a); });
        });
        nav.addEventListener('mouseleave', function () { pill.style.opacity = '0'; shown = false; });
      });
    })();
  </script>
</body>
</html>
