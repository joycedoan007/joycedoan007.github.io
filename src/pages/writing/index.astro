---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle';
import LangSwitch from '../../components/LangSwitch.astro';
import WritingSidebar from '../../components/WritingSidebar.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import L from '../../components/L.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const all = await getCollection('writing');
const sorted = all.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const recent = sorted.slice(0, 2);
const popular = sorted.filter(e => e.data.popular);

const allVi = await getCollection('writing-vi');
const viOf = (e: (typeof all)[number]) => allVi.find((v) => v.slug === e.slug) ?? e;
const catVi: Record<string, string> = { 'All': 'Tất cả', 'Dashboard design': 'Thiết kế dashboard', 'AI & tools': 'AI & công cụ', 'Principles': 'Nguyên tắc', 'Design systems': 'Hệ thống thiết kế' };
for (const e of all) { const c = e.data.category; if (c) catVi[c] = viOf(e).data.category ?? catVi[c] ?? c; }

function fmtDate(d: string, locale = 'en-US') {
  return new Date(d).toLocaleDateString(locale, { month: 'short', year: 'numeric' });
}
const meta = (e: (typeof all)[number], lang: string) =>
  lang === 'vi' ? `${fmtDate(e.data.date, 'vi-VN')} · ${viOf(e).data.readTime}` : `${fmtDate(e.data.date)} · ${e.data.readTime}`;
---

<Layout title="Writing - Joyce Doan" description="Notes on design craft, AI, and product thinking by Joyce Doan.">

  <header style="position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg-page) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-subtle);">
    <div style="max-width: 100%; padding: 0 24px; height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
      <div style="display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0;">
        <a href="/" style="display: inline-flex; text-decoration: none;">
          <img src="/logo.svg" alt="Joyce Doan" height="18" style="display: block; filter: var(--logo-filter);" />
        </a>
        <span style="font: 400 12px/16px 'JetBrains Mono', monospace; color: var(--text-disabled);">/</span>
        <a href="/writing" data-i18n style="font: 500 13px/20px 'Poppins', sans-serif; color: var(--text-bright); text-decoration: none;">Writing</a>
      </div>
      <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px;">
        <nav class="nav-fx" style="display: flex; align-items: center; margin-right: 12px;">
          {[
            ['Work', '/work'],
            ['Contact', '/contact'],
          ].map(([label, href]) => (
            <a
              href={href}
              data-i18n
              style="padding: 6px 14px; font: 500 13px/20px 'Poppins', sans-serif; color: var(--text-primary); text-decoration: none;"
            >
              {label}
            </a>
          ))}
        </nav>
        <LangSwitch />
        <ThemeToggle client:load />
      </div>
    </div>
  </header>

  <div style="display: grid; grid-template-columns: 220px 1fr; min-height: calc(100vh - 48px);">

    <WritingSidebar entries={sorted} />

    <!-- Main content -->
    <main style="min-width: 0;">

      <!-- Hero -->
      <div style="padding: 56px 72px 48px; border-bottom: 1px solid var(--border-subtle);">
        <div class="overline" style="margin-bottom: 16px;"><L en="Things I figured out" vi="Những điều tôi đã tự mày mò" /></div>
        <h1 style="font: 500 48px/1.0 'Poppins', sans-serif; letter-spacing: -0.04em; color: var(--text-bright); margin: 0 0 12px;"><L en="Writing" vi="Bài viết" /></h1>
        <p style="font: 400 15px/24px 'Poppins', sans-serif; color: var(--text-secondary); margin: 0; max-width: 480px;">
          <L en="Short essays on design thinking, AI, data UX, and the product decisions behind complex interfaces." vi="Những bài viết ngắn về tư duy thiết kế, AI, data UX và các quyết định sản phẩm đằng sau những giao diện phức tạp." />
        </p>
      </div>

      <div style="padding: 56px 72px 96px;">

        <!-- Popular -->
        <div style="margin-bottom: 56px;">
          <h2 style="font: 500 11px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 20px;"><L en="Popular" vi="Phổ biến" /></h2>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
            {popular.map((e) => (
              <a href={`/writing/${e.slug}`} class="writing-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 24px; border: 1px solid var(--border-subtle); border-radius: var(--radius-card); background: var(--bg-surface); text-decoration: none; gap: 32px; transition: border-color 150ms ease;">
                <div>
                  <div class="overline" style="margin-bottom: 10px;"><L en={e.data.category ?? 'Writing'} vi={viOf(e).data.category ?? 'Bài viết'} /></div>
                  <h3 style="font: 500 15px/1.4 'Poppins', sans-serif; color: var(--text-bright); margin: 0 0 8px;"><L en={e.data.title} vi={viOf(e).data.title} /></h3>
                  <p style="font: 400 13px/20px 'Poppins', sans-serif; color: var(--text-secondary); margin: 0;"><L en={e.data.description} vi={viOf(e).data.description} /></p>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                  <span style="font: 400 11px/16px 'JetBrains Mono', monospace; color: var(--text-disabled);"><L en={meta(e, 'en')} vi={meta(e, 'vi')} /></span>
                  <i class="ph-bold ph-arrow-up-right" style="font-size: 13px; color: var(--text-disabled);"></i>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- All posts -->
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <h2 style="font: 500 11px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; margin: 0;"><L en="All posts" vi="Tất cả bài viết" /></h2>
            <div id="writing-filters" style="display: flex; gap: 6px;">
              {['All', 'Dashboard design', 'AI & tools', 'Principles', 'Design systems'].map((cat) => (
                <button
                  data-filter={cat}
                  class="filter-btn"
                  style={`padding: 5px 12px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle); background: ${cat === 'All' ? 'var(--primary-700)' : 'transparent'}; color: ${cat === 'All' ? 'var(--text-inverse)' : 'var(--text-secondary)'}; font: 500 11px/16px 'JetBrains Mono', monospace; letter-spacing: 0.04em; cursor: pointer; transition: all 150ms ease;`}
                >
                  <L en={cat} vi={catVi[cat] ?? cat} />
                </button>
              ))}
            </div>
          </div>
          <div id="post-list">
            {sorted.map((e) => (
              <a href={`/writing/${e.slug}`} class="post-row" data-category={e.data.category ?? ''} style="display: grid; grid-template-columns: 180px 1fr 140px; gap: 24px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border-subtle); text-decoration: none; transition: padding 150ms ease;">
                <span style="font: 400 11px/16px 'JetBrains Mono', monospace; color: var(--text-disabled);"><L en={meta(e, 'en')} vi={meta(e, 'vi')} /></span>
                <span style="font: 500 14px/20px 'Poppins', sans-serif; color: var(--text-bright);"><L en={e.data.title} vi={viOf(e).data.title} /></span>
                <span style="font: 500 10px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.06em; text-transform: uppercase; text-align: right;"><L en={e.data.category ?? ''} vi={viOf(e).data.category ?? ''} /></span>
              </a>
            ))}
          </div>
        </div>

      </div>

    </main>

  </div>

</Layout>

<style>
  .writing-card:hover { border-color: var(--border-default) !important; }
  .writing-card:hover i { color: var(--text-accent) !important; }
  .post-row:hover span:nth-child(2) { color: var(--text-accent) !important; }
  .filter-btn:hover { border-color: var(--border-default) !important; color: var(--text-bright) !important; }
  .filter-btn.active { background: var(--primary-700) !important; color: var(--text-inverse) !important; border-color: var(--primary-700) !important; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('.post-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'All';

      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      rows.forEach((row) => {
        const cat = row.dataset.category ?? '';
        row.style.display = (filter === 'All' || cat === filter) ? 'grid' : 'none';
      });
    });
  });

  document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="All"]')?.classList.add('active');
</script>
