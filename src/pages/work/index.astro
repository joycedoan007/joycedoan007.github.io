---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
import L from '../../components/L.astro';
import '../../styles/global.css';

const all = await getCollection('work');
const sorted = all.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const allVi = await getCollection('work-vi');
const vd = (e: (typeof sorted)[number]) => allVi.find((v) => v.slug === e.slug)?.data ?? e.data;
const catVi: Record<string, string> = { 'Branding': 'Thương hiệu', 'Product Design': 'Thiết kế sản phẩm', 'Web Design': 'Thiết kế web', 'All': 'Tất cả' };
const recent = sorted.slice(0, 2);
const featured = sorted.filter(e => e.data.hasImage).slice(0, 3);
---

<Layout title="Work - Joyce Doan" description="Selected UI/UX design work by Joyce Doan.">

  <Header />

  <div style="display: grid; grid-template-columns: 1fr; min-height: calc(100vh - var(--header-h, 48px));">

    <main style="min-width: 0;">

      <!-- Hero -->
      <div style="padding: 96px max(48px, calc((100% - 1320px) / 2 + 48px)) 48px; border-bottom: 1px solid var(--border-subtle);">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 48px;">
          <div>
            <div class="overline" style="margin-bottom: 12px;" data-i18n>UI/UX Designer</div>
            <h1 style="font: 500 clamp(30px, 3.4vw, 44px)/1.1 'Poppins', sans-serif; letter-spacing: -0.03em; color: var(--text-bright); margin: 0;"><L en="Work" vi="Dự án" /></h1>
          </div>
          <p style="font: 400 15px/24px 'Poppins', sans-serif; color: var(--text-primary); max-width: 360px; margin: 0;">
            <L en="Product UX and web design across analytics, AI, finance, and B2B SaaS." vi="Thiết kế UX sản phẩm và thiết kế web trong các lĩnh vực analytics, AI, tài chính và B2B SaaS." />
          </p>
        </div>
      </div>

      <div style="padding: 56px max(48px, calc((100% - 1320px) / 2 + 48px)) 96px;">

        <!-- Featured -->
        <div style="margin-bottom: 56px;">
          <h2 style="font: 500 11px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 20px;"><L en="Featured" vi="Nổi bật" /></h2>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
            {featured.map((e) => (
              <a href={`/work/${e.slug}`} class="work-card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); background: var(--bg-surface); text-decoration: none; overflow: hidden; transition: border-color 150ms ease;">
                <div style="aspect-ratio: 4/3; overflow: hidden; background: var(--bg-elevated);">
                  <img src={`/work/${e.slug.replace(/^\d+-/, '')}/cover.png`} alt={e.data.title} style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                </div>
                <div style="padding: 20px 24px; display: flex; flex-direction: column; gap: 24px; flex: 1; justify-content: space-between;">
                  <div>
                    <div class="overline" style="margin-bottom: 10px;"><L en={e.data.subtitle} vi={vd(e).subtitle} /></div>
                    <h3 style="font: 500 15px/1.4 'Poppins', sans-serif; color: var(--text-bright); margin: 0 0 8px;"><L en={e.data.title} vi={vd(e).title} /></h3>
                    <p style="font: 400 13px/20px 'Poppins', sans-serif; color: var(--text-secondary); margin: 0;"><L en={e.data.description} vi={vd(e).description} /></p>
                  </div>
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span style="font: 400 11px/16px 'JetBrains Mono', monospace; color: var(--text-disabled);"><L en={e.data.role} vi={vd(e).role} /> · {e.data.year}</span>
                    <i class="ph-bold ph-arrow-up-right" style="font-size: 13px; color: var(--text-disabled);"></i>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- All projects -->
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <h2 style="font: 500 11px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; margin: 0;"><span id="list-label-hand"><L en="All projects" vi="Tất cả dự án" /></span><span id="list-label-ai" hidden><L en="AI projects" vi="Dự án AI" /></span></h2>
            <div style="display: flex; align-items: center; gap: 20px;">
            <div style="position: relative;">
              <button type="button" role="switch" aria-checked="false" id="ai-switch" data-cursor="hover" class="ai-switch ai-switch--sm">
                <span><L en="AI mode" vi="Chế độ AI" /></span>
                <span class="ai-switch__track"><span class="ai-switch__thumb"></span></span>
              </button>
              <span class="ai-sparkles" id="ai-sparkles" aria-hidden="true"></span>
            </div>
            <div id="work-filters" style="display: flex; gap: 6px;">
              {['All', 'Product Design', 'Web Design', 'Branding'].map((cat) => (
                <button
                  data-filter={cat}
                  class="filter-btn"
                  style={`padding: 5px 12px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle); background: ${cat === 'All' ? 'var(--primary-700)' : 'transparent'}; color: ${cat === 'All' ? 'var(--text-inverse)' : 'var(--text-secondary)'}; font: 500 11px/16px 'JetBrains Mono', monospace; letter-spacing: 0.04em; cursor: pointer; transition: all 150ms ease;`}
                >
                  <L en={cat} vi={catVi[cat] ?? cat} />
                </button>
              ))}
            </div>
            </div>
          </div>
          <div id="project-list">
            {sorted.map((e, i) => (
              <a href={`/work/${e.slug}`} class="project-row" data-category={e.data.category ?? ''} data-ai={String(e.data.ai)} style={`display: ${e.data.ai ? 'none' : 'grid'}; grid-template-columns: 1fr 180px 80px; gap: 24px; align-items: center; padding: 16px 0;${i < sorted.length - 1 ? ' border-bottom: 1px solid var(--border-subtle);' : ''} text-decoration: none; transition: padding 150ms ease;`}>
                <span style="font: 500 14px/20px 'Poppins', sans-serif; color: var(--text-bright);"><L en={e.data.title} vi={vd(e).title} /></span>
                <span style="font: 500 10px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); letter-spacing: 0.06em; text-transform: uppercase;"><L en={e.data.category ?? ''} vi={catVi[e.data.category ?? ''] ?? e.data.category ?? ''} /></span>
                <span style="font: 400 11px/16px 'JetBrains Mono', monospace; color: var(--text-disabled); text-align: right;">{e.data.year}</span>
              </a>
            ))}
          </div>
          <nav id="work-pager" aria-label="Pagination" style="display: none; justify-content: center; align-items: center; gap: 6px; margin-top: 32px;"></nav>
        </div>

      </div>

      <ContactCTA />
    </main>

  </div>
  <Footer />

</Layout>

<style>
  .work-card:hover { border-color: var(--border-default) !important; }
  .work-card:hover i { color: var(--text-accent) !important; }
  .project-row:hover span:nth-child(1) { color: var(--text-accent) !important; }
  .pager-btn { min-width: 44px; padding: 0 14px; }
  .pager-btn:disabled { opacity: 0.4; cursor: default; }
  .pager-btn.active { border-color: var(--text-bright); }
  .filter-btn:hover { border-color: var(--border-default) !important; color: var(--text-bright) !important; }
  .filter-btn.active { background: var(--primary-700) !important; color: var(--text-inverse) !important; border-color: var(--primary-700) !important; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('.project-row');
  const aiSwitch = document.getElementById('ai-switch') as HTMLButtonElement;
  const labelHand = document.getElementById('list-label-hand')!;
  const labelAi = document.getElementById('list-label-ai')!;
  const sparkles = document.getElementById('ai-sparkles')!;
  const pager = document.getElementById('work-pager')!;
  const PER_PAGE = 7;
  let filter = 'All';
  let aiMode = false;
  const list = document.getElementById('project-list')!;
  let listHeight = 0;
  let page = 1;

  // Hand-designed work shows by default; AI projects only when AI mode is on.
  function apply(animate: boolean) {
    let n = 0;
    const matching = [...rows].filter((row) => {
      const isAi = row.dataset.ai === 'true';
      const cat = row.dataset.category ?? '';
      return isAi === aiMode && (filter === 'All' || cat === filter);
    });
    const pages = Math.max(1, Math.ceil(matching.length / PER_PAGE));
    page = Math.min(page, pages);
    const shown = new Set(matching.slice((page - 1) * PER_PAGE, page * PER_PAGE));
    const lastShown = [...shown].pop();
    rows.forEach((row) => {
      const visible = shown.has(row);
      row.style.display = visible ? 'grid' : 'none';
      row.style.borderBottom = row === lastShown ? 'none' : '1px solid var(--border-subtle)';
      row.classList.remove('ai-row');
      if (visible && animate) {
        row.style.setProperty('--i', String(n++));
        void row.offsetWidth; // restart the entrance animation
        row.classList.add('ai-row');
        row.classList.toggle('ai-row--magic', aiMode);
      }
    });
    labelHand.hidden = aiMode;
    labelAi.hidden = !aiMode;
    // Keep the table at the height of a full page so it doesn't shrink on short pages or filters.
    const sample = [...shown][0];
    if (sample && !listHeight) {
      listHeight = sample.getBoundingClientRect().height * PER_PAGE;
      list.style.minHeight = `${listHeight}px`;
    }
    renderPager(pages);
  }

  function renderPager(pages: number) {
    pager.innerHTML = '';
    pager.style.display = pages > 1 ? 'flex' : 'none';
    const add = (label: string, to: number, opts: { active?: boolean; disabled?: boolean; aria?: string } = {}) => {
      const b = document.createElement('button');
      b.className = 'btn btn--secondary pager-btn' + (opts.active ? ' active' : '');
      b.textContent = label;
      b.disabled = !!opts.disabled;
      if (opts.aria) b.setAttribute('aria-label', opts.aria);
      if (opts.active) b.setAttribute('aria-current', 'page');
      b.addEventListener('click', () => { page = to; apply(false); });
      pager.appendChild(b);
    };
    add('←', page - 1, { disabled: page === 1, aria: 'Previous page' });
    for (let i = 1; i <= pages; i++) add(String(i), i, { active: i === page });
    add('→', page + 1, { disabled: page === pages, aria: 'Next page' });
  }

  function burst() {
    sparkles.innerHTML = '';
    for (let i = 0; i < 10; i++) {
      const a = (i / 10) * Math.PI * 2;
      const d = 26 + (i % 3) * 10;
      const el = document.createElement('i');
      el.textContent = '✦';
      el.style.setProperty('--dx', `${Math.cos(a) * d}px`);
      el.style.setProperty('--dy', `${Math.sin(a) * d}px`);
      el.style.setProperty('--delay', `${(i % 4) * 40}ms`);
      sparkles.appendChild(el);
    }
  }

  aiSwitch.addEventListener('click', () => {
    aiMode = !aiMode;
    page = 1;
    aiSwitch.setAttribute('aria-checked', String(aiMode));
    aiSwitch.classList.toggle('is-on', aiMode);
    if (aiMode) burst();
    else sparkles.innerHTML = '';
    apply(true);
  });

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter ?? 'All';
      page = 1;
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      apply(false);
    });
  });

  // Set "All" as active on load
  document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="All"]')?.classList.add('active');
  apply(false);
</script>
