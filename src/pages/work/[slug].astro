---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
import L from '../../components/L.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const w = entry.data;

const allVi = await getCollection('work-vi');
const viOf = (slug: string) => allVi.find((e) => e.slug === slug);
const viEntry = viOf(entry.slug);
const ViContent = viEntry ? (await viEntry.render()).Content : Content;
const wv = viEntry?.data ?? w;

const all = await getCollection('work');
const sorted = all.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const idx = sorted.findIndex(e => e.slug === entry.slug);
const more = [1, 2, 3].map((n) => sorted[(idx + n) % sorted.length]).filter((e) => e.slug !== entry.slug);
const catVi: Record<string, string> = { 'Branding': 'Thương hiệu', 'Product Design': 'Thiết kế sản phẩm', 'Web Design': 'Thiết kế web' };
---

<Layout title={`${w.title} - Joyce Doan`} description={w.description}>
  <Header />

  <main class="case">
    <!-- Hero -->
    <section class="case__hero">
      <nav aria-label="Breadcrumb" class="case__crumb">
        <a href="/work" class="breadcrumb-link" data-cursor="hover"><L en="Work" vi="Dự án" /></a>
        <i class="ph-bold ph-caret-right" style="font-size: 10px;"></i>
        <span aria-current="page"><L en={w.title} vi={wv.title} /></span>
      </nav>
      <div class="overline" style="margin-bottom: 16px;"><L en={w.category ?? 'Case study'} vi={catVi[w.category ?? ''] ?? w.category ?? 'Dự án'} />{' · '}{w.year}</div>
      <h1 class="case__title"><L en={w.title} vi={wv.title} /></h1>
      <p class="case__lede"><L en={w.description} vi={wv.description} /></p>
      <div class="case__actions">
        <a href="/contact" class="btn btn--primary btn--lg" data-cursor="hover"><L en="Book a call" vi="Đặt lịch gọi" /></a>
        {w.url && (
          <a href={w.url} target="_blank" rel="noopener noreferrer" class="btn btn--secondary btn--lg" data-cursor="hover">
            <L en="Visit website" vi="Truy cập website" />
            <i class="ph-bold ph-arrow-up-right"></i>
          </a>
        )}
      </div>
      <dl class="case__meta">
        {w.role && <div><dt><L en="Role" vi="Vai trò" /></dt><dd><L en={w.role} vi={wv.role} /></dd></div>}
        {w.company && <div><dt><L en="Company" vi="Công ty" /></dt><dd>{w.company}</dd></div>}
        <div><dt><L en="Year" vi="Năm" /></dt><dd>{w.year}</dd></div>
        <div class="case__skills"><dt><L en="Skills" vi="Kỹ năng" /></dt><dd>{w.skills.map((k) => <span>{k}</span>)}</dd></div>
      </dl>
      {w.hasImage && (
        <div class="case__visual grain-img" data-reveal>
          <img src={`/work/${entry.slug.replace(/^\d+-/, '')}/cover.png`} alt={w.title} />
        </div>
      )}
    </section>

    <!-- Story -->
    <section class="case__body">
      <div class="prose" data-lang-block="en"><Content /></div>
      <div class="prose" data-lang-block="vi"><ViContent /></div>
    </section>

    <!-- More projects -->
    <section class="case__more">
      <h2 class="case__h2"><L en="Explore more projects" vi="Khám phá thêm dự án" /></h2>
      <div class="case__cards">
        {more.map((m, i) => (
          <a href={`/work/${m.slug}`} class="case-card" data-cursor="hover" data-reveal style={`--reveal-delay: ${i * 80}ms;`}>
            {m.data.hasImage && (
              <div class="case-card__img grain-img"><img src={`/work/${m.slug.replace(/^\d+-/, '')}/cover.png`} alt="" loading="lazy" /></div>
            )}
            <div class="case-card__text">
              <h3><L en={m.data.title} vi={viOf(m.slug)?.data.title ?? m.data.title} /></h3>
              <p><L en={m.data.subtitle} vi={viOf(m.slug)?.data.subtitle ?? m.data.subtitle} /></p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <ContactCTA />
  <Footer />
</Layout>

<style is:global>
  .case { max-width: 1320px; margin: 0 auto; padding: 0 48px; }
  .case__hero { padding: 40px 0 0; display: flex; flex-direction: column; align-items: flex-start; }
  .case__crumb { display: flex; align-items: center; gap: 8px; margin-bottom: 56px; font: 500 12px/16px 'JetBrains Mono', monospace; color: var(--text-secondary); }
  .case__crumb a { color: inherit; text-decoration: none; transition: color 150ms ease; }
  .case__crumb [aria-current] { color: var(--text-bright); }
  .case__title { font: 500 clamp(32px, 4vw, 48px)/1.05 'Poppins', sans-serif; letter-spacing: -0.04em; color: var(--text-bright); margin: 0 0 20px; max-width: 760px; text-wrap: balance; }
  .case__lede { font: 400 16px/26px 'Poppins', sans-serif; color: var(--text-secondary); margin: 0 0 32px; max-width: 600px; text-wrap: pretty; }
  .case__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 56px; }
  .case__meta { display: flex; flex-wrap: wrap; gap: 24px 56px; margin: 0 0 64px; padding: 24px 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); width: 100%; }
  .case__meta dt { font: 500 11px/16px 'JetBrains Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-disabled); margin-bottom: 8px; }
  .case__meta dd { margin: 0; font: 500 14px/20px 'Poppins', sans-serif; color: var(--text-bright); }
  .case__skills dd { display: flex; flex-wrap: wrap; gap: 6px; }
  .case__skills dd span { padding: 2px 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-full); font: 500 11px/18px 'JetBrains Mono', monospace; color: var(--text-secondary); }
  .case__visual { width: 100%; border-radius: 24px; overflow: hidden; border: 1px solid var(--border-subtle); background: var(--bg-surface); }
  .case__visual img { display: block; width: 100%; height: auto; }
  .case__body { max-width: 976px; margin: 0 auto; padding: 96px 0 120px; }
  .case__h2 { font: 500 clamp(26px, 3vw, 36px)/1.1 'Poppins', sans-serif; letter-spacing: -0.03em; color: var(--text-bright); margin: 0 0 40px; }
  .case__more { padding: 0 0 120px; }
  .case__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .case-card { display: flex; flex-direction: column; border: 1px solid var(--border-subtle); border-radius: var(--radius-card); background: var(--bg-surface); text-decoration: none; overflow: hidden; transition: border-color 200ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .case-card:hover { border-color: var(--border-default); transform: translateY(-4px); }
  .case-card__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-elevated); }
  .case-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
  .case-card:hover .case-card__img img { transform: scale(1.04); }
  .case-card__text { padding: 20px 24px 24px; }
  .case-card h3 { font: 500 18px/1.3 'Poppins', sans-serif; color: var(--text-bright); margin: 0 0 6px; }
  .case-card p { font: 400 14px/22px 'Poppins', sans-serif; color: var(--text-secondary); margin: 0; }
  @media (max-width: 900px) {
    .case { padding: 0 20px; }
    .case__cards { grid-template-columns: 1fr; }
    .case__meta { gap: 20px 32px; }
  }
  .breadcrumb-link:hover { color: var(--text-accent) !important; }
  .nav-link:hover { border-color: var(--border-default) !important; }
  .prose p { font: 400 16px/28px 'Poppins', sans-serif; color: var(--text-primary); margin: 0 0 20px; }
  .prose h2 { font: 600 22px/1.2 'Poppins', sans-serif; letter-spacing: -0.02em; color: var(--text-bright); margin: 48px 0 16px; }
  .prose h3 { font: 600 16px/1.3 'Poppins', sans-serif; color: var(--text-bright); margin: 28px 0 10px; }
  .prose strong { font-weight: 600; color: var(--text-bright); }
  .prose ul { margin: 0 0 20px; padding-left: 20px; }
  .prose li { font: 400 15px/26px 'Poppins', sans-serif; color: var(--text-primary); margin-bottom: 6px; }
  .prose hr { border: none; border-top: 1px solid var(--border-subtle); margin: 40px 0; }
  .prose img { width: 100%; border-radius: var(--radius-card); border: 1px solid var(--border-subtle); margin: 24px 0; display: block; }
</style>
