---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import WorkPortfolio from '../components/WorkPortfolio';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Writing from '../components/Writing.astro';
import CalBooking from '../components/CalBooking.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';

const writingEntries = await getCollection('writing');
const writingEntriesVi = await getCollection('writing-vi');
const writingItems = writingEntries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((e) => {
    const vi = writingEntriesVi.find((v) => v.slug === e.slug)?.data ?? e.data;
    return {
      ...e.data,
      slug: e.slug,
      titleVi: vi.title,
      descriptionVi: vi.description,
      readTimeVi: vi.readTime,
      categoryVi: vi.category,
    };
  });

const workEntries = await getCollection('work');
const workViEntries = await getCollection('work-vi');
const byOrder = workEntries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
// Hand-designed work shows by default; AI projects only appear when "AI mode" is on.
const workItems = [...byOrder.filter((e) => !e.data.ai).slice(0, 5), ...byOrder.filter((e) => e.data.ai)]
  .map((entry) => ({
    id: entry.slug,
    slug: entry.slug,
    image: ['hover', 'cover'].map((n) => `/work/${entry.slug.replace(/^\d+-/, '')}/${n}.png`).find((f) => existsSync(`public${f}`)) ?? '',
    tag: entry.data.subtitle,
    title: entry.data.title,
    year: entry.data.year ?? '',
    role: entry.data.role,
    titleVi: workViEntries.find((v) => v.slug === entry.slug)?.data.title ?? entry.data.title,
    tagVi: workViEntries.find((v) => v.slug === entry.slug)?.data.subtitle ?? entry.data.subtitle,
    summaryVi: workViEntries.find((v) => v.slug === entry.slug)?.data.description ?? entry.data.description,
    roleVi: workViEntries.find((v) => v.slug === entry.slug)?.data.role ?? entry.data.role,
    size: entry.data.skills.join(' · '),
    accent: 'dark' as const,
    summary: entry.data.description,
    problem: '',
    approach: '',
    outcome: '',
    metrics: [] as { value: string; label: string }[],
    featured: entry.data.order === 1,
    ai: entry.data.ai,
    order: entry.data.order ?? 99,
  }));


const SITE = {
  name: 'Joyce Doan',
  role: 'UI/UX Designer',
  company: 'Consortia Group',
  email: 'joycedoan.007@gmail.com',
  socials: [
    { label: 'LinkedIn', icon: 'linkedin-logo', href: 'https://linkedin.com/in/joycedoan007' },
    { label: 'X', icon: 'x-logo', href: 'https://x.com/joycedoan007' },
    { label: 'Instagram', icon: 'instagram-logo', href: 'https://instagram.com/joycedoan007' },
  ],
  stats: [
    { n: '3+ yrs', l: 'Designing software' },
    { n: '15+', l: 'Shipped projects' },
    { n: '05', l: 'Dashboards built' },
    { n: '∞', l: 'Pixels nudged' },
  ],
};
---

<Layout title="Joyce Doan - UI/UX Designer" description="UI/UX designer focused on data-driven products. Dashboards, complex interfaces, AI.">
  <CustomCursor client:load />
  <Header />
  <main>
    <Hero stats={SITE.stats} company={SITE.company} />
    <Marquee />
    <WorkPortfolio
      client:load
      workItemsJson={JSON.stringify(workItems)}
    />
    <About role={SITE.role} company={SITE.company} />
    <Services />
    <Writing items={writingItems} />
    <CalBooking />
  </main>
  <Footer />
</Layout>
